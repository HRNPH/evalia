{
  "name": "backend",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src",
  "projectType": "application",
  "tags": ["scope:backend"],
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run dev",
        "cwd": "backend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run build",
        "cwd": "backend"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun src/index.ts",
        "cwd": "backend"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run lint",
        "cwd": "backend"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run type-check",
        "cwd": "backend"
      }
    }
  }
}
